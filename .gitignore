# Gradle / Android build outputs
.gradle/
build/
**/build/

# Gradle wrapper JAR is required; ignore other JARs/AARs
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.aar

# Machine-local SDK path (never commit)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# APK / packaging artifacts
*.apk
*.aab
*.ap_
*.dex
output-metadata.json

# Signing material
*.jks
*.keystore

# Editor (project source lives elsewhere)
.vscode/
.cursor/

# Logs / diagnostics
*.log
*.hprof

# OS junk
.DS_Store
Thumbs.db
